# Temporary visual QA screenshots
tmp/

# Quarto and Jekyll build artifacts
.quarto/
_site/
.jekyll-cache/
.sass-cache/

# Operating system metadata
.DS_Store

# Source articles and screenshots stay local (copyrighted / large)
*.pdf
*.[Pp][Nn][Gg]
# ...except the title-slide thumbnails shown on the GitHub Pages index
!**/lead-slide.png
# ...and the site icons
!assets/icons/*.png
# ...and the product logos used on the VS Code setup deck's tool profile slides
!ai_vscode_start/assets/logos/*.png

# Quarto render scratch
**/.quarto/
**/*.quarto_ipynb

# API keys (Short.io); copy .env.example to .env
.env

# Python bytecode
__pycache__/
*.pyc
